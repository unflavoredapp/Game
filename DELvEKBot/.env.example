# Phone worker — copy to .env beside delvekbot-worker.sh
DECRYPT_SITE_URL=https://delvek.bot/
DECRYPT_WORKER_TOKEN=paste-from-/etc/delvekbot.env-on-vps
BUDDY3_BIN=/var/mobile/Documents/buddy3
BUDDY3_OUT_DIR=/var/mobile/Documents

POLL_SECONDS=3
HEARTBEAT_SECONDS=30
COUNTRY=us
BUDDY3_VERBOSE=0
CURL_CONNECT_TIMEOUT=15
CURL_MAX_TIME=60
UPLOAD_MAX_TIME=1800
