# DELvEKBot phone worker configuration
# Copy to .env beside delvekbot-worker.sh (auto-loaded). Never commit real tokens.
DECRYPT_SITE_URL=https://your-server.example/
DECRYPT_WORKER_TOKEN=replace-with-a-unique-worker-token
BUDDY3_BIN=/var/mobile/Documents/buddy3
BUDDY3_OUT_DIR=/var/mobile/Documents

# Give every phone a unique ID.
DELVEKBOT_ADID=iphone-worker-01

POLL_SECONDS=3
HEARTBEAT_SECONDS=30
COUNTRY=us
BUDDY3_VERBOSE=0
CURL_CONNECT_TIMEOUT=15
CURL_MAX_TIME=60
UPLOAD_MAX_TIME=1800
