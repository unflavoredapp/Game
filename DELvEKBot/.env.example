# Phone worker — copy to .env beside delvekbot-worker.sh
DECRYPT_SITE_URL=https://delvek.bot/
DECRYPT_WORKER_TOKEN=paste-from-/etc/delvekbot.env-on-vps
BUDDY3_BIN=/var/jb/usr/local/bin/buddy3
BUDDY3_OUT_DIR=/var/mobile/Documents

DELVEKBOT_PHONE=iphone-multi-01
COUNTRY=us
# Comma list, or omit to use keys from phone/accounts.json
COUNTRIES=us,in
DELVEKBOT_PHONE_DIR=./phone

SKIP_FETCH=0
SKIP_ACCOUNT_SWITCH=0
FETCH_WAIT_SECONDS=8

POLL_SECONDS=3
HEARTBEAT_SECONDS=30
BUDDY3_VERBOSE=0
CURL_CONNECT_TIMEOUT=15
CURL_MAX_TIME=60
UPLOAD_MAX_TIME=1800
