[Unit]
Description=DELvEKBot decrypt queue API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/delvekbot/server
EnvironmentFile=/etc/delvekbot.env
ExecStart=/opt/delvekbot/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8080 --workers 1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
